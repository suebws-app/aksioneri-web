# ─── Required ─────────────────────────────────────────────

# The SAME database aksioneri-api reads. better-auth writes its tables here.
DATABASE_URL=postgres://aksioneri:aksioneri@localhost:5433/aksioneri

# Byte-identical to aksioneri-api/.env. Min 32 chars.
# Generate with: openssl rand -base64 32
AUTH_COOKIE_SECRET=replace-me-with-at-least-32-characters

# Public origin of this app. Required in production.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# aksioneri-api base URL, including the /api prefix. Required in production.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public contact address shown on /contact, /privacy, /terms.
# Required in production so a launch cannot ship the local placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@aksioneri.com


# ─── Optional (defaults shown) ────────────────────────────

# App
NODE_ENV=development

# Force <meta name="robots" content="noindex"> across the site.
NOINDEX=false

# Set to true once transactional email is wired up.
REQUIRE_EMAIL_VERIFICATION=false

# Sessions
SESSION_TTL_SECONDS=2592000
SESSION_UPDATE_AGE_SECONDS=604800
MIN_PASSWORD_LENGTH=8
NEXT_PUBLIC_MIN_PASSWORD_LENGTH=8

# IANA timezone the calendar renders release times in.
NEXT_PUBLIC_DISPLAY_TZ=Europe/Belgrade

# Human-facing brand name shown in metadata and OG tags. Override on staging
# so the environment marker appears in the tab (e.g. "Aksioneri (Staging)").
NEXT_PUBLIC_SITE_NAME=Aksioneri

# Transactional email (Brevo). Leave BREVO_API_KEY empty to no-op.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Aksioneri

# Sentry — leave DSN empty to disable
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# PostHog — leave KEY empty to disable
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
