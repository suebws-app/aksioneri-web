# Public origin of this app. REQUIRED in production.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# aksioneri-api base URL, including the /api prefix. REQUIRED in production.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public contact address shown on /contact, /privacy and /terms.
# REQUIRED in production so a launch cannot ship the local placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@aksioneri.com

# IANA timezone the calendar renders release times in.
NEXT_PUBLIC_DISPLAY_TZ=Europe/Belgrade

# Human-facing brand name shown in metadata and OG tags. Override on staging
# so the environment marker appears in the tab (e.g. "Aksioneri (Staging)").
NEXT_PUBLIC_SITE_NAME=Aksioneri

# The SAME database aksioneri-api uses. better-auth writes its tables here.
DATABASE_URL=postgres://aksioneri:aksioneri@localhost:5433/aksioneri

# Must be byte-identical to aksioneri-api/.env — better-auth signs the session
# cookie with this and the API verifies the signature.
# Generate with: openssl rand -base64 32
AUTH_COOKIE_SECRET=replace-me-with-at-least-32-characters

# Set to true once transactional email is wired up
REQUIRE_EMAIL_VERIFICATION=false
